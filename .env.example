# Supabase connection for the frontend (values: Supabase dashboard → Settings → API).
# These are client-side "publishable" values — the anon key is meant to ship in the
# browser bundle and every table is protected by row-level security. Keep real values
# in an untracked .env anyway so forks and CI can point at their own project.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
